// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A registered user of the Kanban Board application.
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  // Boards owned by this user
  boards       Board[]
  // Boards this user has been invited to / collaborated on
  boardUsers   BoardUser[]
  // Invitations this user has sent to other users
  invitationsSent     BoardInvitation[] @relation("InvitationsSent")
  // Invitations this user has received from board owners
  invitationsReceived BoardInvitation[] @relation("InvitationsReceived")
}

/// A Kanban board — the top-level container for columns and tasks.
model Board {
  id         String      @id @default(uuid())
  title      String
  ownerId    String
  createdAt  DateTime    @default(now())
  // Soft-delete timestamp; null = active, non-null = tombstoned
  deletedAt  DateTime?
  owner      User        @relation(fields: [ownerId], references: [id])
  columns    Column[]
  sharedWith BoardUser[]
  invitations BoardInvitation[]
}

/// Join table representing a user's collaboration access to a board.
model BoardUser {
  id       String   @id @default(uuid())
  boardId  String
  userId   String
  // When the user joined the board — used to sort the members list
  joinedAt DateTime @default(now())
  board    Board    @relation(fields: [boardId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([boardId, userId])
}

/// A workflow stage (column) within a board.
model Column {
  id       String @id @default(uuid())
  title    String
  boardId  String
  position Int    // Ordering within the board
  board    Board  @relation(fields: [boardId], references: [id])
  tasks    Task[]
}

/// An individual work item within a column.
model Task {
  id          String   @id @default(uuid())
  title       String
  description String?  // Optional
  columnId    String
  position    Int      // Ordering within the column
  createdAt   DateTime @default(now())
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

/// Status of a board-ownership invitation. PENDING is the only state in which
/// an invitee can accept; the other terminal states are write-once.
enum BoardInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

/// A pending (or terminal) invitation for a user to collaborate on a board.
/// The invitee must already be a registered user — see Phase 2 Plan §4.
model BoardInvitation {
  id        String                @id @default(uuid())
  boardId   String
  inviterId String
  inviteeId String
  status    BoardInvitationStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  inviter User  @relation("InvitationsSent",     fields: [inviterId], references: [id])
  invitee User  @relation("InvitationsReceived", fields: [inviteeId], references: [id])

  @@index([inviteeId, status])
  @@index([boardId, status])
}
